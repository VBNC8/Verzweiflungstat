/*
 * Hawk keymap — Corne keymap with outer pinky columns removed.
 *
 * Key position reference (36 positions total):
 *
 *   Left 5×3 (pos 0–14):
 *     0  1  2  3  4   ← top row  (Q  W  E  R  T)
 *     5  6  7  8  9   ← mid row  (A  S  D  F  G)
 *    10 11 12 13 14   ← bot row  (Z  X  C  V  B)
 *
 *   Left thumbs (pos 15–17):
 *    15 16 17
 *
 *   Right 5×3 (pos 18–32, peripheral offset +18):
 *    18 19 20 21 22   ← top row  (Y  U  I  O  P)
 *    23 24 25 26 27   ← mid row  (H  J  K  L  ö)
 *    28 29 30 31 32   ← bot row  (N  M  ,  .  DEL)
 *
 *   Right thumbs (pos 33–35):
 *    33 34 35
 *
 * Special functions via chord combos (special switches wired in parallel
 * to the common key AND the partner key):
 *   BT / USB  — common key T (pos 4):
 *     X+G(9)  = BT0 (ws)
 *     X+S(6)  = BT1 (ge)
 *     X+A(5)  = BT2 (bl)
 *     X+D(7)  = USB (rt)
 *     X (gn)
 *     GND (sw)
 *   5-way nav — common key Q (pos 0):
 *     Q+Z(10) = Nav Up
 *     Q+X(11) = Nav Down
 *     Q+C(12) = Nav Left
 *     Q+V(13) = Nav Right
 *     Q+B(14) = Nav OK
 */


#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        pair_paren: pair_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LS(N8)>, <&kp LS(N9)>, <&kp LEFT>;
        };

        pair_brc: pair_brc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp RA(N7)>, <&kp RA(N0)>, <&kp LEFT>;
        };

        pair_bkt: pair_bkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp RA(N8)>, <&kp RA(N9)>, <&kp LEFT>;
        };

        usb_on: usb_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_USB>;
        };

        bt_sel_0: bt_sel_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };

        bt_sel_1: bt_sel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };

        bt_sel_2: bt_sel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };
        
        bt_sel_3: bt_sel_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };

        bt_sel_4: bt_sel_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 4>;
        };

        durchmesser: durchmesser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N8>, <&macro_release &kp LALT>;
        };

        smiley: smiley {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp COMMA>, <&macro_release &kp LSHFT>, <&macro_tap &kp SLASH>, <&macro_press &kp LSHFT>, <&macro_tap &kp N9>, <&macro_release &kp LSHFT>;
        };

        nbsp: nbsp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N0>, <&macro_release &kp LALT>;
        };

        macro_bt_clr: macro_bt_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
        
        // Makro sendet den Befehl und "wartet" dann einfach, bis du loslässt
        m_pp: m_pp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&kp C_PP>; 
        };
        m_next: m_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_NEXT>;
        };
        m_prev: m_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_PREV>;
        };
        // Makro für UP mit Wiederholung
        m_up: m_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp UP>
                , <&macro_pause_for_release>
                , <&macro_release &kp UP>;
        };

        // Makro für DOWN mit Wiederholung
        m_down: m_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp DOWN>
                , <&macro_pause_for_release>
                , <&macro_release &kp DOWN>;
        };
    };

    behaviors {
        caps_wrd: caps_wrd {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <NON_US_HASH KP_DIVIDE BACKSPACE DEL SLASH SQT SEMI LBKT>;
        };

        hrm_safe: hrm_safe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <220>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
        };

        hrm_shift: hrm_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <260>;       // Wieder höher! Du MUSST das F/J bewusst halten für Shift
            quick-tap-ms = <150>;          // Verhindert Fehlauslösungen bei schnellen Doppelbuchstaben
            require-prior-idle-ms = <150>; // ABSOLUT KRITISCH: Blockiert Shift, wenn du mitten im Wort bist
            flavor = "tap-preferred";      // Im Zweifel IMMER der Buchstabe f/j beim schnellen Schreiben
            bindings = <&kp>, <&kp>;
        };

        lt_hp: lt_hp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };

        enc_bt_clr: enc_bt_clr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <5000>;
            flavor = "tap-preferred";
            bindings = <&macro_bt_clr>, <&none>;
        };

    };

    combos {
        compatible = "zmk,combos";

        // ==========================================
        // 1. SYSTEMATISCHER TEST: Knackige HRM-Combos (35ms)
        // Diese liegen auf Tasten mit Modifikatoren (F, J, X, C)
        // ==========================================
        combo_creo_mod   { timeout-ms = <35>; key-positions = <11 12>; bindings = <&kp LC(LALT)>; layers = <0 1>; }; // X + C
        combo_caps_word  { timeout-ms = <35>; key-positions = <8 24>;  bindings = <&caps_wrd>; layers = <0>; };    // F + J
        combo_quote      { timeout-ms = <35>; key-positions = <7 8>;   bindings = <&kp LS(N2)>; layers = <0 1>; }; // D + F
        combo_question   { timeout-ms = <35>; key-positions = <24 25>; bindings = <&kp LS(MINUS)>; layers = <0 1>; }; // J + K
        combo_ue         { timeout-ms = <35>; key-positions = <19 24>; bindings = <&kp LBKT>; layers = <0>; };     // U + J


        // ==========================================
        // 2. UNKRITISCHE COMBOS (Komfortable 45-50ms)
        // Hier liegen keine Modifikatoren, das Timing darf entspannt sein
        // ==========================================
        combo_excl       { timeout-ms = <45>; key-positions = <2 7>;   bindings = <&kp LS(N1)>; layers = <0 1>; };
        combo_colon      { timeout-ms = <45>; key-positions = <30 31>; bindings = <&kp LS(DOT)>; layers = <0 1>; }; // , + . (Zwar HRM, aber unkritisch für f/j)
        combo_backslash  { timeout-ms = <45>; key-positions = <25 26>; bindings = <&kp RA(MINUS)>; layers = <0 1>; };
        combo_slash      { timeout-ms = <45>; key-positions = <6 7>;   bindings = <&kp KP_DIVIDE>; layers = <0 1>; };
        combo_minus      { timeout-ms = <45>; key-positions = <26 27>; bindings = <&kp SLASH>; layers = <0 1>; };
        combo_underscore { timeout-ms = <45>; key-positions = <5 6>;   bindings = <&kp LS(SLASH)>; layers = <0 1>; };
        combo_ae         { timeout-ms = <50>; key-positions = <0 5>;   bindings = <&kp SQT>; layers = <0>; };      // Q + A (Pinky)
        combo_oe         { timeout-ms = <45>; key-positions = <21 26>; bindings = <&kp SEMI>; layers = <0>; };     // O + L
        combo_ss         { timeout-ms = <45>; key-positions = <1 6>;   bindings = <&kp MINUS>; layers = <0>; };


        // ==========================================
        // 3. HARDWARE-COMBOS (Bleiben auf 2ms)
        // ==========================================
        combo_bt0 { timeout-ms = <2>; key-positions = <11 9>; bindings = <&bt_sel_0>; };
        combo_bt1 { timeout-ms = <2>; key-positions = <11 6>; bindings = <&bt_sel_1>; };
        combo_bt2 { timeout-ms = <2>; key-positions = <11 5>; bindings = <&bt_sel_2>; };
        combo_usb { timeout-ms = <2>; key-positions = <11 7>; bindings = <&usb_on>; };
        
        combo_up    { timeout-ms = <2>; key-positions = <0 11 14>; bindings = <&kp UP>;    layers = <0>; };
        combo_down  { timeout-ms = <2>; key-positions = <0 10 14>; bindings = <&kp DOWN>;  layers = <0>; };
        combo_prev  { timeout-ms = <2>; key-positions = <0 12 14>; bindings = <&m_prev>;   layers = <0>; };
        combo_next  { timeout-ms = <2>; key-positions = <0 13 14>; bindings = <&m_next>;   layers = <0>; };
        combo_pp    { timeout-ms = <2>; key-positions = <0 14>;    bindings = <&m_pp>;     layers = <0>; };

        combo_up_l1   { timeout-ms = <2>; key-positions = <0 11 14>; bindings = <&kp UP>;    layers = <1>; };
        combo_down_l1 { timeout-ms = <2>; key-positions = <0 10 14>; bindings = <&kp DOWN>;  layers = <1>; };
        combo_prev_l1 { timeout-ms = <2>; key-positions = <0 12 14>; bindings = <&kp LEFT>;  layers = <1>; };
        combo_next_l1 { timeout-ms = <2>; key-positions = <0 13 14>; bindings = <&kp RIGHT>; layers = <1>; };
        combo_pp_l1   { timeout-ms = <2>; key-positions = <0 14>;    bindings = <&m_pp>;     layers = <1>; };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Each layer has exactly 36 bindings in this position order:
         *   Pos  0– 4 : left top    (alpha)     Pos 18–22 : right top    (alpha)
         *   Pos  5– 9 : left mid    (alpha)     Pos 23–27 : right mid    (alpha)
         *   Pos 10–14 : left bot    (alpha)     Pos 28–32 : right bot    (alpha)
         *   Pos 15–17 : left thumbs             Pos 33–35 : right thumbs
         */
        default_layer {
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
/* left top  */   &kp Q          &kp W                &kp E                 &kp R                &kp T
/* left mid  */   &kp A          &kp S                &kp D                 &hrm_shift LSHIFT F  &kp G
/* left bot  */   &kp Z          &hrm_safe LCTRL X    &hrm_safe LALT C      &kp V                &kp B
/* left tmb  */                                       &kp C_PP              &lt 2 ESC            &lt 1 TAB

/* right top */   &kp Y          &kp U                &kp I                 &kp O                &kp P
/* right mid */   &kp H          &hrm_shift RSHIFT J  &kp K                 &kp L                &kp LS(NON_US_HASH)
/* right bot */   &kp N          &kp M                &hrm_safe RALT COMMA  &hrm_safe RCTRL DOT  &kp DEL
/* right tmb */   &lt 1 RET      &lt_hp 2 SPACE       &kp BSPC
            >;
        };

        lower_layer {
            sensor-bindings = <&inc_dec_kp LA(TAB) LA(LS(TAB))>;
            bindings = <
/* left top  */   &kp GRAVE      &kp NON_US_BSLH   &kp LS(NON_US_BSLH)  &durchmesser   &smiley
/* left mid  */   &kp N1         &kp N2            &kp N3               &kp N4         &kp N5
/* left bot  */   &kp RA(RBKT)   &kp LS(N5)        &kp RA(NON_US_BSLH)  &kp LS(N4)     &kp NON_US_HASH
/* left tmb  */                                    &mo 3                &kp LGUI       &kp HOME

/* right top */   &kp LS(GRAVE)  &pair_paren       &pair_brc            &pair_bkt       &kp LS(N6)
/* right mid */   &kp N6         &kp N7            &kp N8               &kp N9          &kp N0
/* right bot */   &kp KP_PLUS    &kp KP_MULTIPLY   &kp COMMA            &kp DOT         &kp LS(N0)
/* right tmb */   &kp END        &kp LG(D)         &mo 3
            >;
        };

        raise_layer {
            sensor-bindings = <&inc_dec_kp UP DOWN>;
            bindings = <
/* left top  */   &kp F1         &kp F2            &kp F3               &kp F4            &kp F5     
/* left mid  */   &trans         &trans            &trans               &trans            &trans
/* left bot  */   &kp LA(F4)     &trans            &trans               &trans            &trans
/* left tmb  */                                    &kp F14              &kp LC(LS(ESC))   &trans

/* right top */   &kp F6         &kp F7            &kp F8               &kp F9          &kp F10
/* right mid */   &kp UP         &kp LEFT          &kp DOWN             &kp RIGHT       &kp PLUS
/* right bot */   &trans         &trans            &trans               &trans          &kp EQUAL
/* right tmb */   &trans         &nbsp             &trans
            >;
        };

        adjust_layer {
            sensor-bindings = <&inc_dec_kp UP DOWN>;
            bindings = <
/* left top  */   &trans         &trans            &trans               &trans          &trans
/* left mid  */   &bt_sel_0      &bt_sel_1         &bt_sel_2            &bt_sel_3       &bt_sel_4
/* left bot  */   &usb_on        &ext_power EP_TOG &trans               &bootloader     &sys_reset
/* left tmb  */                                    &enc_bt_clr 0 0      &trans          &trans

/* right top */   &trans         &trans            &trans               &trans          &trans
/* right mid */   &trans         &trans            &trans               &trans          &trans
/* right bot */   &sys_reset     &bootloader       &kp C_PREV           &kp C_NEXT      &trans
/* right tmb */   &trans         &trans            &kp F12
            >;
        };
    };
};
