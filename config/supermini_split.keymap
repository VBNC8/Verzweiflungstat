/*
 * Supermini Split keymap — Corne keymap with outer pinky columns removed.
 *
 * Key position reference (40 positions total):
 *
 *   Left 5×3 (pos 0–14):
 *     0  1  2  3  4   ← top row  (Q  W  E  R  T)
 *     5  6  7  8  9   ← mid row  (A  S  D  F  G)
 *    10 11 12 13 14   ← bot row  (Z  X  C  V  B)
 *
 *   Left thumbs (pos 15–17):
 *    15 16 17
 *
 *   BT-switcher via special pin P1.15 (pos 18–21):
 *    18=BT0  19=BT1  20=BT2  21=USB_OUT
 *
 *   Right 5×3 (pos 22–36, peripheral offset +22):
 *    22 23 24 25 26   ← top row  (Y  U  I  O  P)
 *    27 28 29 30 31   ← mid row  (H  J  K  L  ö)
 *    32 33 34 35 36   ← bot row  (N  M  ,  .  DEL)
 *
 *   Right thumbs (pos 37–39):
 *    37 38 39
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        pair_paren: pair_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LS(N8)>, <&kp LS(N9)>, <&kp LEFT>;
        };

        pair_brc: pair_brc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp RA(N7)>, <&kp RA(N0)>, <&kp LEFT>;
        };

        pair_bkt: pair_bkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp RA(N8)>, <&kp RA(N9)>, <&kp LEFT>;
        };

        usb_on: usb_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_USB>;
        };

        bt_sel_0: bt_sel_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };

        bt_sel_1: bt_sel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };

        bt_sel_2: bt_sel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };

        durchmesser: durchmesser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N8>, <&macro_release &kp LALT>;
        };

        smiley: smiley {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp COMMA>, <&macro_release &kp LSHFT>, <&macro_tap &kp SLASH>, <&macro_press &kp LSHFT>, <&macro_tap &kp N9>, <&macro_release &kp LSHFT>;
        };

        nbsp: nbsp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N0>, <&macro_release &kp LALT>;
        };

        macro_bt_clr: macro_bt_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        caps_wrd: caps_wrd {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <POUND BACKSPACE DEL MINUS UNDERSCORE>;
        };

        hrm_safe: hrm_safe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
        };

        hrm_shift: hrm_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <100>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
        };

        lt_hp: lt_hp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };

        enc_bt_clr: enc_bt_clr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <5000>;
            flavor = "tap-preferred";
            bindings = <&macro_bt_clr>, <&none>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // ! (E + D) - Vertikal Mittelfinger
        combo_excl {
            timeout-ms = <40>;
            key-positions = <2 7>; // E=2, D=7
            bindings = <&kp LS(N1)>;
            layers = <0 1>;
        };

        // Doppelpunkt (:) auf , und .
        combo_colon {
            timeout-ms = <50>;
            key-positions = <34 35>; // ,=34, .=35
            bindings = <&kp LS(DOT)>;
            layers = <0 1>;
        };

        // CREO: Ctrl+Alt auf X und C (Links unten)
        combo_creo_mod {
            timeout-ms = <50>;
            key-positions = <11 12>; // X=11, C=12
            bindings = <&kp LC(LALT)>;
            layers = <0>;
        };

        // Backslash (\) auf K und L
        combo_backslash {
            timeout-ms = <40>;
            key-positions = <29 30>; // K=29, L=30
            bindings = <&kp RA(MINUS)>;
            layers = <0 1>;
        };

        // Slash (/) auf S und D
        combo_slash {
            timeout-ms = <40>;
            key-positions = <6 7>; // S=6, D=7
            bindings = <&kp KP_DIVIDE>;
            layers = <0 1>;
        };

        // Minus/Bindestrich (-) auf L und Ö
        combo_minus {
            timeout-ms = <50>;
            key-positions = <30 31>; // L=30, ö=31
            bindings = <&kp SLASH>;
            layers = <0 1>;
        };

        // Unterstrich (_) auf A und S
        combo_underscore {
            timeout-ms = <40>;
            key-positions = <5 6>; // A=5, S=6
            bindings = <&kp LS(SLASH)>;
            layers = <0 1>;
        };

        // Caps Word auf F und J
        combo_caps_word {
            timeout-ms = <40>;
            key-positions = <8 28>; // F=8, J=28
            bindings = <&caps_wrd>;
            layers = <0>;
        };

        // Gänsefüßchen (") auf D und F
        combo_quote {
            timeout-ms = <50>;
            key-positions = <7 8>; // D=7, F=8
            bindings = <&kp LS(N2)>;
            layers = <0 1>;
        };

        // Fragezeichen (?) auf J und K
        combo_question {
            timeout-ms = <50>;
            key-positions = <28 29>; // J=28, K=29
            bindings = <&kp LS(MINUS)>;
            layers = <0 1>;
        };

        // Ä (Q + A) - Vertikal linker Zeigefinger
        combo_ae {
            timeout-ms = <55>;
            key-positions = <0 5>; // Q=0, A=5
            bindings = <&kp SQT>;
            layers = <0>;
        };

        // Ö (O + L) - Vertikal rechter Ringfinger
        combo_oe {
            timeout-ms = <50>;
            key-positions = <25 30>; // O=25, L=30
            bindings = <&kp SEMI>;
            layers = <0>;
        };

        // Ü (U + J) - Vertikal rechter Zeigefinger
        combo_ue {
            timeout-ms = <50>;
            key-positions = <23 28>; // U=23, J=28
            bindings = <&kp LBKT>;
            layers = <0>;
        };

        // ß (W + S) - Vertikal linker Ringfinger
        combo_ss {
            timeout-ms = <50>;
            key-positions = <1 6>; // W=1, S=6
            bindings = <&kp MINUS>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * Each layer has exactly 40 bindings.
         * Order: left top (0–4), left mid (5–9), left bot (10–14),
         *        left thumbs (15–17), BT sel (18–21),
         *        right top (22–26), right mid (27–31), right bot (32–36),
         *        right thumbs (37–39).
         */
        default_layer {
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp DOWN UP>;
            bindings = <
/* left top  */   &kp Q          &kp W             &kp E              &kp R                &kp T
/* left mid  */   &kp A          &kp S             &hrm_safe LCTRL D  &hrm_shift LSHIFT F  &kp G
/* left bot  */   &kp Z          &hrm_safe LALT X  &kp C              &kp V                &kp B
/* left tmb  */   &lt_hp 3 C_PP  &lt 2 ESC         &lt 1 TAB
/* BT sel    */   &bt_sel_0      &bt_sel_1         &bt_sel_2          &usb_on
/* right top */   &kp Y          &kp U             &kp I              &kp O                &kp P
/* right mid */   &kp H          &hrm_shift RSHIFT J  &hrm_safe RCTRL K  &kp L            &kp LS(NON_US_HASH)
/* right bot */   &kp N          &kp M             &kp COMMA          &hrm_safe RALT DOT   &kp DEL
/* right tmb */   &lt 1 RET      &lt_hp 2 SPACE    &lt_hp 3 BSPC
            >;
        };

        lower_layer {
            sensor-bindings = <&inc_dec_kp LA(TAB) LA(LS(TAB))>, <&inc_dec_kp PG_DN PG_UP>;
            bindings = <
/* left top  */   &kp GRAVE      &kp NON_US_BSLH   &kp LS(NON_US_BSLH)  &durchmesser   &smiley
/* left mid  */   &kp N1         &kp N2            &kp N3               &kp N4         &kp N5
/* left bot  */   &kp RA(RBKT)   &kp LS(N5)        &kp RA(NON_US_BSLH)  &kp LS(N4)     &kp NON_US_HASH
/* left tmb  */   &enc_bt_clr 0 0  &kp LGUI        &kp HOME
/* BT sel    */   &bt_sel_0      &bt_sel_1         &bt_sel_2            &usb_on
/* right top */   &kp LS(GRAVE)  &pair_paren       &pair_brc            &pair_bkt       &kp LS(BSLH)
/* right mid */   &kp N6         &kp N7            &kp N8               &kp N9          &kp N0
/* right bot */   &kp KP_PLUS    &kp KP_MULTIPLY   &kp COMMA            &kp DOT         &kp LS(N0)
/* right tmb */   &kp END        &kp LG(D)         &trans
            >;
        };

        raise_layer {
            sensor-bindings = <&inc_dec_kp UP DOWN>, <&inc_dec_kp UP DOWN>;
            bindings = <
/* left top  */   &kp F1         &kp F2            &kp F3               &kp F4          &kp F5
/* left mid  */   &trans         &trans            &trans               &trans          &trans
/* left bot  */   &trans         &trans            &trans               &trans          &trans
/* left tmb  */   &kp F14        &kp LC(LS(ESC))   &trans
/* BT sel    */   &bt_sel_0      &bt_sel_1         &bt_sel_2            &usb_on
/* right top */   &kp F6         &kp F7            &kp F8               &kp F9          &kp F10
/* right mid */   &kp UP         &kp LEFT          &kp DOWN             &kp RIGHT       &kp PLUS
/* right bot */   &trans         &trans            &trans               &trans          &kp EQUAL
/* right tmb */   &trans         &nbsp             &trans
            >;
        };

        adjust_layer {
            sensor-bindings = <&inc_dec_kp UP DOWN>, <&inc_dec_kp UP DOWN>;
            bindings = <
/* left top  */   &trans         &trans            &trans               &trans          &trans
/* left mid  */   &bt_sel_0      &bt_sel_1         &bt_sel_2            &trans          &trans
/* left bot  */   &usb_on        &ext_power EP_TOG &trans               &trans          &trans
/* left tmb  */   &kp F14        &trans            &trans
/* BT sel    */   &bt_sel_0      &bt_sel_1         &bt_sel_2            &usb_on
/* right top */   &trans         &trans            &trans               &trans          &kp LA(F4)
/* right mid */   &trans         &trans            &trans               &trans          &trans
/* right bot */   &trans         &trans            &kp C_PREV           &kp C_NEXT      &trans
/* right tmb */   &trans         &trans            &kp F12
            >;
        };
    };
};
