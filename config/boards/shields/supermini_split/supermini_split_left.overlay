/*
 * Left half overlay — Super mini nrf52840
 *
 * Pin assignment (D-label → nRF52840 pin → ZMK GPIO):
 *
 *   Key  0  P0.09  D7   — top row, col 0  (Q)
 *   Key  1  P0.18  D18  — top row, col 1  (W)
 *   Key  2  P0.19  D19  — top row, col 2  (E)
 *   Key  3  P0.29  D20  — top row, col 3  (R)
 *   Key  4  P0.31  D21  — top row, col 4  (T)
 *   Key  5  P0.02  D15  — mid row, col 0  (A)
 *   Key  6  P0.03  D14  — mid row, col 1  (S)
 *   Key  7  P0.28  D16  — mid row, col 2  (D)
 *   Key  8  P0.10  D10  — mid row, col 3  (F)
 *   Key  9  P0.08  D1   — mid row, col 4  (G)
 *   Key 10  P0.17  D2   — bot row, col 0  (Z/Y)
 *   Key 11  P0.20  D3   — bot row, col 1  (X)
 *   Key 12  P0.22  D4   — bot row, col 2  (C)
 *   Key 13  P0.24  D5   — bot row, col 3  (V)
 *   Key 14  P1.00  D6   — bot row, col 4  (B)
 *   Key 15  P0.06  D0   — left thumb out  (encoder push / layer)
 *   Key 16  P0.11  D8   — left thumb mid  (ESC / layer)
 *   Key 17  P0.31  D9   — left thumb in   (TAB / layer)
 *                         NOTE: same nRF pin as key 4 (T/P0.31) per user table —
 *                         verify hardware; two kscan-gpio-direct keys cannot share a GPIO.
 *
 *   Encoder (rotary, centre bottom pads):
 *     A   P1.01
 *     B   P1.02
 *
 *   9 special-function switches:
 *     BT / USB — wired in parallel to T (P0.31) + partner key:
 *     BT0     → T (P0.31) + A (P0.02)   → combo T+A fires bt_sel_0
 *     BT1     → T (P0.31) + S (P0.03)   → combo T+S fires bt_sel_1
 *     BT2     → T (P0.31) + D (P0.28)   → combo T+D fires bt_sel_2
 *     USB_OUT → T (P0.31) + F (P0.10)   → combo T+F fires usb_on
 *     5-way nav — wired in parallel to Q (P0.09) + partner key:
 *     Nav Up  → Q (P0.09) + Y (right)   → combo Q+Y fires &kp UP
 *     Nav Dn  → Q (P0.09) + X (P0.20)   → combo Q+X fires &kp DOWN
 *     Nav Lt  → Q (P0.09) + C (P0.22)   → combo Q+C fires &kp LEFT
 *     Nav Rt  → Q (P0.09) + V (P0.24)   → combo Q+V fires &kp RIGHT
 *     Nav OK  → Q (P0.09) + B (P1.00)   → combo Q+B fires &kp RET
 *
 * Key-position map (used in keymap / combos):
 *   Left  keys : 0–17   (18 direct, this half)
 *   Right keys : 18–35  (sent by peripheral, offset +18)
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /* 18 direct keys — each switch: GPIO pin → GND */
    kscan0: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&gpio0  9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  0  P0.09  Q */
            , <&gpio0 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  1  P0.18  W */
            , <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  2  P0.19  E */
            , <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  3  P0.29  R */
            , <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  4  P0.31  T */
            , <&gpio0  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  5  P0.02  A */
            , <&gpio0  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  6  P0.03  S */
            , <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  7  P0.28  D */
            , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  8  P0.10  F */
            , <&gpio0  8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  9  P0.08  G */
            , <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 10  P0.17  Z */
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 11  P0.20  X */
            , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 12  P0.22  C */
            , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 13  P0.24  V */
            , <&gpio1  0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 14  P1.00  B */
            , <&gpio0  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 15  P0.06  thumb out */
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 16  P0.11  thumb mid */
            , <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 17  P0.31  thumb in  (same pin as key 4 — verify!) */
            ;
    };

    /* rotary encoder (A = P1.01, B = P1.02 — centre bottom pads) */
    encoder_left: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio1  1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_left>;
        triggers-per-rotation = <20>;
    };

    /*
     * Matrix transform: 1 row × 18 cols, 18 central entries.
     *   Pos  0– 4 : left top    RC(0,0)–RC(0,4)
     *   Pos  5– 9 : left mid    RC(0,5)–RC(0,9)
     *   Pos 10–14 : left bot    RC(0,10)–RC(0,14)
     *   Pos 15–17 : left thumbs RC(0,15)–RC(0,17)
     * Peripheral offset = 18  →  right keys at pos 18–35.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <18>;
        rows = <1>;
        map = <
            /* left top */
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)
            /* left mid */
            RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)
            /* left bot */
            RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
            /* left thumbs */
            RC(0,15) RC(0,16) RC(0,17)
        >;
    };
};
