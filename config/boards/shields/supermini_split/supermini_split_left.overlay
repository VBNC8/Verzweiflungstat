/*
 * Left half overlay — Super mini nrf52840
 *
 * Pin assignment (verify against your PCB):
 *
 *   18 key GPIOs (P0.xx, right edge + left edge):
 *     Key  0  P0.02 — top row, col 0
 *     Key  1  P0.03 — top row, col 1
 *     Key  2  P0.04 — top row, col 2
 *     Key  3  P0.05 — top row, col 3
 *     Key  4  P0.06 — top row, col 4
 *     Key  5  P0.07 — mid row, col 0
 *     Key  6  P0.08 — mid row, col 1
 *     Key  7  P0.09 — mid row, col 2
 *     Key  8  P0.10 — mid row, col 3
 *     Key  9  P0.14 — mid row, col 4
 *     Key 10  P0.15 — bot row, col 0
 *     Key 11  P0.16 — bot row, col 1
 *     Key 12  P0.18 — bot row, col 2
 *     Key 13  P0.19 — bot row, col 3
 *     Key 14  P0.20 — bot row, col 4
 *     Key 15  P0.00 — left thumb 1 (encoder push / layer)
 *     Key 16  P0.01 — left thumb 2 (ESC / layer)
 *     Key 17  P0.21 — left thumb 3 (TAB / layer)
 *
 *   Encoder (5-way rotary on left):
 *     A   P1.11
 *     B   P1.13
 *
 *   Special pin ("second GND"):
 *     P1.15 — row output driven LOW when scanning BT-switcher & 5-way switch
 *
 *   4 special switches (BT-switcher), each wired between a key GPIO and
 *   the special pin.  Uses the first 4 key GPIOs (keys 0–3):
 *     BT0     → P0.02 + P1.15
 *     BT1     → P0.03 + P1.15
 *     BT2     → P0.04 + P1.15
 *     USB_OUT → P0.05 + P1.15
 *
 * Key-position map (used in keymap / combos):
 *   Left regular keys  : 0–17   (18 direct)
 *   Left special keys  : 18–21  (BT0, BT1, BT2, USB_OUT via special pin)
 *   Right regular keys : 22–39  (sent by peripheral, offset +22)
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /*
     * Composite kscan:
     *   row 0 (offset 0) — 18 direct keys to GND
     *   row 1 (offset 1) — 9 special switches to special_pin
     */
    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <2>;
        columns = <18>;

        direct_keys {
            kscan = <&kscan_direct>;
            row-offset = <0>;
        };

        special_keys {
            kscan = <&kscan_special>;
            row-offset = <1>;
        };
    };

    /* 18 direct keys — each switch: GPIO pin → GND */
    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&gpio0  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  0  P0.02 */
            , <&gpio0  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  1  P0.03 */
            , <&gpio0  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  2  P0.04 */
            , <&gpio0  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  3  P0.05 */
            , <&gpio0  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  4  P0.06 */
            , <&gpio0  7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  5  P0.07 */
            , <&gpio0  8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  6  P0.08 */
            , <&gpio0  9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  7  P0.09 */
            , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  8  P0.10 */
            , <&gpio0 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key  9  P0.14 */
            , <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 10  P0.15 */
            , <&gpio0 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 11  P0.16 */
            , <&gpio0 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 12  P0.18 */
            , <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 13  P0.19 */
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 14  P0.20 */
            , <&gpio0  0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 15  P0.00 */
            , <&gpio0  1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 16  P0.01 */
            , <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* key 17  P0.21 */
            ;
    };

    /*
     * Special-pin matrix (1 row = P1.15, 9 cols = shared key GPIOs).
     * row2col: P1.15 driven LOW → col GPIO reads LOW when switch closed.
     * Diodeless: a simultaneously pressed regular key on the same GPIO
     * also reads LOW.  BT/5-way presses should not coincide with typing.
     */
    kscan_special: kscan_special {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";

        row-gpios
            = <&gpio1 15 GPIO_ACTIVE_LOW>                    /* P1.15 special pin */
            ;

        col-gpios
            = <&gpio0  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* BT0     P0.02 */
            , <&gpio0  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* BT1     P0.03 */
            , <&gpio0  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* BT2     P0.04 */
            , <&gpio0  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   /* USB_OUT P0.05 */
            ;
    };

    /* 5-way rotary encoder (A = P1.11, B = P1.13) */
    encoder_left: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_left>;
        triggers-per-rotation = <20>;
    };

    /*
     * Matrix transform: 2 rows × 18 cols, 22 entries total.
     *
     *   Pos  0– 4 : left top row    RC(0,0)–RC(0,4)
     *   Pos  5– 9 : left mid row    RC(0,5)–RC(0,9)
     *   Pos 10–14 : left bot row    RC(0,10)–RC(0,14)
     *   Pos 15–17 : left thumbs     RC(0,15)–RC(0,17)
     *   Pos 18–21 : BT sel + USB   RC(1,0)–RC(1,3)
     *   Pos 22–39 : right keys      (peripheral offset +22)
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <18>;
        rows = <2>;
        map = <
            /* left top */
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)
            /* left mid */
            RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)
            /* left bot */
            RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
            /* left thumbs */
            RC(0,15) RC(0,16) RC(0,17)
            /* BT selector (hardware switch via special pin) */
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)
        >;
    };
};
