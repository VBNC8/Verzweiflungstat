/*
 * handwired_left.keymap
 *
 * 42 bindings per layer  (3 rows × 12 + 6 thumb keys)
 * position = row*12 + col  (rows 0-2); positions 36-41 for thumb row
 *
 * Row 0 (0-11):  LCol0  Q   W   E   R   T  | Y   U   I   O   P   RCol0
 * Row 1 (12-23): LCol0  A   S   D   F   G  | H   J   K   L   ;   RCol0
 * Row 2 (24-35): EC11L  Z   X   C   V   B  | N   M   ,   .   DEL EC11R
 * Row 3 (36-41): LT3 LT2 LT1 | RT1 RT2 RT3
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

#define LEFT_HAND_KEYS   1  2  3  4  5 13 14 15 16 17 25 26 27 28 29 36 37 38
#define RIGHT_HAND_KEYS  6  7  8  9 10 18 19 20 21 22 30 31 32 33 34 39 40 41

/ {
    macros {
        pair_paren: pair_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>; tap-ms = <10>;
            bindings = <&kp LS(N8)>, <&kp LS(N9)>, <&kp LEFT>;
        };

        pair_brc: pair_brc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>; tap-ms = <10>;
            bindings = <&kp RA(N7)>, <&kp RA(N0)>, <&kp LEFT>;
        };

        pair_bkt: pair_bkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>; tap-ms = <10>;
            bindings = <&kp RA(N8)>, <&kp RA(N9)>, <&kp LEFT>;
        };

        usb_on: usb_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_USB>;
        };

        bt_sel_0: bt_sel_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };

        bt_sel_1: bt_sel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };

        bt_sel_2: bt_sel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };

        bt_sel_3: bt_sel_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };

        bt_sel_4: bt_sel_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 4>;
        };

        durchmesser: durchmesser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N8>, <&macro_release &kp LALT>;
        };

        smiley: smiley {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp COMMA>, <&macro_release &kp LSHFT>, <&macro_tap &kp SLASH>, <&macro_press &kp LSHFT>, <&macro_tap &kp N9>, <&macro_release &kp LSHFT>;
        };

        nbsp: nbsp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>; tap-ms = <30>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N0>, <&macro_release &kp LALT>;
        };

        macro_bt_clr: macro_bt_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };

        m_pp: m_pp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>; tap-ms = <10>;
            bindings = <&kp C_PP>;
        };

        m_next: m_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_NEXT>;
        };

        m_prev: m_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_PREV>;
        };

        m_up: m_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>; tap-ms = <0>;
            bindings = <&macro_press &kp UP>, <&macro_pause_for_release>, <&macro_release &kp UP>;
        };

        m_down: m_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>; tap-ms = <0>;
            bindings = <&macro_press &kp DOWN>, <&macro_pause_for_release>, <&macro_release &kp DOWN>;
        };
    };

    behaviors {
        lt_enter: lt_enter {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            flavor = "hold-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };

        caps_wrd: caps_wrd {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <NON_US_HASH KP_DIVIDE BACKSPACE DEL SLASH SQT SEMI LBKT>;
        };

        hrm_safe: hrm_safe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <220>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
        };

        hrm_left: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hrm_right: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <170>;
            require-prior-idle-ms = <80>;
            hold-trigger-key-positions = <LEFT_HAND_KEYS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        lt_hp: lt_hp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };

        enc_bt_clr: enc_bt_clr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <5000>;
            flavor = "tap-preferred";
            bindings = <&macro_bt_clr>, <&none>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* 1. Knackige HRM-Combos (35ms) */
        combo_caps_word  { timeout-ms = <35>; key-positions = <16 19>; bindings = <&caps_wrd>; layers = <0>; };    // F (16) + J (19)
        combo_quote      { timeout-ms = <35>; key-positions = <15 16>; bindings = <&kp LS(N2)>; layers = <0 1>; }; // D (15) + F (16)
        combo_question   { timeout-ms = <35>; key-positions = <19 20>; bindings = <&kp LS(MINUS)>; layers = <0 1>; }; // J (19) + K (20)
        combo_ue         { timeout-ms = <35>; key-positions = <7 19>;  bindings = <&kp LBKT>; layers = <0>; };     // U (7) + J (19)

        /* 2. Unkritische Combos (45-50ms) */
        combo_excl       { timeout-ms = <45>; key-positions = <3 15>;  bindings = <&kp LS(N1)>; layers = <0 1>; };  // E (3) + D (15)
        combo_colon      { timeout-ms = <45>; key-positions = <32 33>; bindings = <&kp LS(DOT)>; layers = <0 1>; }; // , (32) + . (33)
        combo_backslash  { timeout-ms = <45>; key-positions = <20 21>; bindings = <&kp RA(MINUS)>; layers = <0 1>; }; // K (20) + L (21)
        combo_slash      { timeout-ms = <45>; key-positions = <14 15>; bindings = <&kp KP_DIVIDE>; layers = <0 1>; }; // S (14) + D (15)
        combo_minus      { timeout-ms = <45>; key-positions = <21 22>; bindings = <&kp SLASH>; layers = <0 1>; }; // L (21) + Ö (22)
        combo_underscore { timeout-ms = <35>; key-positions = <13 14>; bindings = <&kp LS(SLASH)>; layers = <0 1>; }; // A (13) + S (14)
        combo_ae         { timeout-ms = <50>; key-positions = <1 13>;  bindings = <&kp SQT>; layers = <0>; };     // Q (1) + A (13)
        combo_oe         { timeout-ms = <45>; key-positions = <9 21>;  bindings = <&kp SEMI>; layers = <0>; };    // O (9) + L (21)
        combo_ss         { timeout-ms = <45>; key-positions = <2 14>;  bindings = <&kp MINUS>; layers = <0>; };   // W (2) + S (14)

        /* 3. Hardware- & Special-Combos (2ms) */
        combo_bt0 { timeout-ms = <2>; key-positions = <26 17>; bindings = <&bt_sel_0>; }; // X (26) + G (17)
        combo_bt1 { timeout-ms = <2>; key-positions = <26 14>; bindings = <&bt_sel_1>; }; // X (26) + S (14)
        combo_bt2 { timeout-ms = <2>; key-positions = <26 13>; bindings = <&bt_sel_2>; }; // X (26) + A (13)
        combo_usb { timeout-ms = <2>; key-positions = <26 15>; bindings = <&usb_on>; };   // X (26) + D (15)

        combo_up       { timeout-ms = <2>; key-positions = <1 26 29>; bindings = <&kp UP>;    layers = <0>; }; // Q (1) + X (26) + B (29)
        combo_down     { timeout-ms = <2>; key-positions = <1 25 29>; bindings = <&kp DOWN>;  layers = <0>; }; // Q (1) + Z (25) + B (29)
        combo_prev     { timeout-ms = <2>; key-positions = <1 27 29>; bindings = <&m_prev>;   layers = <0>; }; // Q (1) + C (27) + B (29)
        combo_next     { timeout-ms = <2>; key-positions = <1 28 29>; bindings = <&m_next>;   layers = <0>; }; // Q (1) + V (28) + B (29)
        combo_pp       { timeout-ms = <2>; key-positions = <1 29>;    bindings = <&m_pp>;     layers = <0>; }; // Q (1) + B (29)

        combo_up_l1    { timeout-ms = <2>; key-positions = <1 26 29>; bindings = <&kp UP>;    layers = <1>; };
        combo_down_l1  { timeout-ms = <2>; key-positions = <1 25 29>; bindings = <&kp DOWN>;  layers = <1>; };
        combo_prev_l1  { timeout-ms = <2>; key-positions = <1 27 29>; bindings = <&kp LEFT>;  layers = <1>; };
        combo_next_l1  { timeout-ms = <2>; key-positions = <1 28 29>; bindings = <&kp RIGHT>; layers = <1>; };
        combo_pp_l1    { timeout-ms = <2>; key-positions = <1 29>;    bindings = <&m_pp>;     layers = <1>; };

        combo_del_last_word {
            timeout-ms = <45>;
            key-positions = <36 41>;
            bindings = <&kp LC(BSPC)>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0 – Default */
        default_layer {
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
&none   &kp Q              &kp W              &kp E                &kp R       &kp T        &kp Y         &kp U              &kp I                 &kp O                &kp P                              &none
&none   &hrm_left LSHIFT A &kp S              &kp D                &kp F       &kp G        &kp H         &kp J              &kp K                 &kp L                &hrm_right RSHIFT LS(NON_US_HASH)  &none
&kp C_PP &kp Z             &hrm_safe LCTRL X  &hrm_safe LALT C     &kp V       &kp B        &kp N         &kp M              &hrm_safe RALT COMMA  &hrm_safe RCTRL DOT  &kp DEL                            &kp C_PP
                                              &kp C_PP             &lt 1 ESC   &lt 2 TAB    &lt_enter 2 RET &lt_hp 1 SPACE   &kp BSPC
            >;
        };

        /* Layer 1 – Lower (symbols / numbers) */
        lower_layer {
            sensor-bindings = <&inc_dec_kp LA(TAB) LA(LS(TAB))>;
            bindings = <
&none   &kp GRAVE    &kp NON_US_BSLH  &kp LS(NON_US_BSLH)  &durchmesser  &smiley       &kp LS(GRAVE)  &pair_paren      &pair_brc  &pair_bkt  &kp LS(N6)  &none
&none   &kp N1       &kp N2           &kp N3               &kp N4        &kp N5        &kp N6         &kp N7           &kp N8     &kp N9     &kp N0      &none
&trans  &kp RA(RBKT) &kp LS(N5)       &kp RA(NON_US_BSLH)  &kp LS(N4)    &kp NON_US_HASH &kp KP_PLUS  &kp KP_MULTIPLY  &kp COMMA  &kp DOT    &kp LS(N0)  &trans
                                      &lt 3 LG(D)          &sk LGUI      &trans        &trans         &trans           &lt_hp 3 BSPC
            >;
        };

        /* Layer 2 – Raise (navigation / function) */
        raise_layer {
            sensor-bindings = <&inc_dec_kp UP DOWN>;
            bindings = <
&none   &kp F1      &kp F2  &kp F3  &kp F4           &kp F5    &kp F6   &kp F7    &kp F8    &kp F9     &kp F10   &none
&none   &trans      &trans  &trans  &trans           &trans    &kp UP   &kp LEFT  &kp DOWN  &kp RIGHT  &kp PLUS  &none
&trans  &kp LA(F4)  &trans  &trans  &trans           &trans    &trans   &trans    &trans    &trans     &kp EQUAL &trans
                            &kp F14 &kp LC(LS(ESC))  &kp HOME  &kp END  &nbsp     &trans
            >;
        };

        /* Layer 3 – Adjust */
        adjust_layer {
            sensor-bindings = <&inc_dec_kp UP DOWN>;
            bindings = <
&none   &trans     &trans             &trans     &trans       &trans      &trans      &trans       &trans      &trans      &trans   &none
&none   &bt_sel_0  &bt_sel_1          &bt_sel_2  &bt_sel_3    &bt_sel_4   &trans      &trans       &trans      &trans      &trans   &none
&trans  &usb_on    &ext_power EP_TOG  &trans     &bootloader  &sys_reset  &sys_reset  &bootloader  &kp C_PREV  &kp C_NEXT  &trans   &trans
                                      &trans     &bt BT_CLR   &trans      &trans      &bt BT_CLR   &trans
            >;
        };
    };
};
